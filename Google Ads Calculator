<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Google Ads ROI Calculator</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.js"></script>
<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --bg: #f7f6f3;
    --surface: #ffffff;
    --surface2: #f0efe9;
    --border: #e2e0d8;
    --border-strong: #c8c5bb;
    --text: #1a1916;
    --text-2: #6b6860;
    --text-3: #9e9b93;
    --accent: #1a5cff;
    --accent-light: #e8eeff;
    --accent-dark: #0f3dbf;
    --green: #0d7a4e;
    --green-light: #e6f7ef;
    --amber: #b45309;
    --amber-light: #fef3c7;
    --teal: #0e7490;
    --teal-light: #e0f2fe;
    --radius: 10px;
    --radius-lg: 16px;
  }

  body {
    font-family: 'DM Sans', sans-serif;
    background: var(--bg);
    color: var(--text);
    min-height: 100vh;
    padding: 2rem 1rem;
    font-size: 15px;
    line-height: 1.6;
  }

  .page {
    max-width: 860px;
    margin: 0 auto;
  }

  .header {
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--border);
  }

  .header-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .header h1 {
    font-size: 1.6rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--text);
    line-height: 1.2;
  }

  .header p {
    font-size: 0.875rem;
    color: var(--text-2);
    margin-top: 0.4rem;
  }

  .badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.75rem;
    font-weight: 500;
    padding: 5px 12px;
    border-radius: 100px;
    white-space: nowrap;
  }

  .badge-blue { background: var(--accent-light); color: var(--accent-dark); }
  .badge-green { background: var(--green-light); color: var(--green); }
  .badge-amber { background: var(--amber-light); color: var(--amber); }

  .dot { width: 6px; height: 6px; border-radius: 50%; background: currentColor; }

  .grid-2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
    margin-bottom: 1.25rem;
  }

  @media (max-width: 600px) {
    .grid-2 { grid-template-columns: 1fr; }
    .scenario-grid { grid-template-columns: 1fr !important; }
  }

  .card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 1.25rem 1.5rem;
  }

  .card-label {
    font-size: 0.75rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-3);
    margin-bottom: 1rem;
  }

  .slider-group { margin-bottom: 1.1rem; }
  .slider-group:last-child { margin-bottom: 0; }

  .slider-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 0.4rem;
  }

  .slider-header label {
    font-size: 0.875rem;
    color: var(--text-2);
    font-weight: 400;
  }

  .slider-header .val {
    font-family: 'DM Mono', monospace;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--text);
  }

  input[type="range"] {
    -webkit-appearance: none;
    appearance: none;
    width: 100%;
    height: 4px;
    background: var(--border);
    border-radius: 2px;
    outline: none;
    cursor: pointer;
  }

  input[type="range"]::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: var(--accent);
    cursor: pointer;
    border: 2px solid white;
    box-shadow: 0 1px 4px rgba(26,92,255,0.3);
    transition: transform 0.15s;
  }

  input[type="range"]::-webkit-slider-thumb:hover {
    transform: scale(1.15);
  }

  input[type="range"]::-moz-range-thumb {
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: var(--accent);
    cursor: pointer;
    border: 2px solid white;
    box-shadow: 0 1px 4px rgba(26,92,255,0.3);
  }

  .metrics-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    margin-bottom: 1.25rem;
  }

  @media (max-width: 600px) {
    .metrics-grid { grid-template-columns: repeat(2, 1fr); }
  }

  .metric-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1rem 1.1rem;
  }

  .metric-card .m-label {
    font-size: 0.72rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-3);
    margin-bottom: 0.35rem;
  }

  .metric-card .m-value {
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--text);
    letter-spacing: -0.02em;
    font-family: 'DM Mono', monospace;
    line-height: 1.1;
  }

  .metric-card .m-sub {
    font-size: 0.72rem;
    color: var(--text-3);
    margin-top: 0.3rem;
  }

  .metric-card.accent { border-color: var(--accent); background: var(--accent-light); }
  .metric-card.accent .m-value { color: var(--accent-dark); }
  .metric-card.green { border-color: #6ee7b7; background: var(--green-light); }
  .metric-card.green .m-value { color: var(--green); }

  .section-title {
    font-size: 0.75rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--text-3);
    margin-bottom: 0.85rem;
  }

  .scenario-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .scenario {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 1.1rem 1.25rem;
  }

  .scenario.featured {
    border-color: var(--accent);
    box-shadow: 0 0 0 3px rgba(26,92,255,0.08);
  }

  .scenario .s-tag {
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: 0.6rem;
  }

  .scenario.featured .s-tag { color: var(--accent); }
  .scenario:not(.featured) .s-tag { color: var(--text-3); }

  .scenario .s-profit {
    font-size: 1.4rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    font-family: 'DM Mono', monospace;
    color: var(--text);
    margin-bottom: 0.75rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--border);
  }

  .scenario .s-row {
    display: flex;
    justify-content: space-between;
    font-size: 0.8rem;
    padding: 3px 0;
    color: var(--text-2);
  }

  .scenario .s-row span:last-child {
    font-weight: 500;
    color: var(--text);
    font-family: 'DM Mono', monospace;
  }

  .chart-section {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 1.25rem 1.5rem;
    margin-bottom: 1.25rem;
  }

  .chart-legend {
    display: flex;
    gap: 1.25rem;
    margin-bottom: 1rem;
    flex-wrap: wrap;
  }

  .legend-item {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.8rem;
    color: var(--text-2);
  }

  .legend-dot {
    width: 10px;
    height: 10px;
    border-radius: 2px;
  }

  .chart-wrap {
    position: relative;
    width: 100%;
    height: 200px;
  }

  .pitch-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 1.5rem;
    margin-bottom: 1.25rem;
  }

  .pitch-card h3 {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text);
    margin-bottom: 1rem;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .pitch-icon {
    width: 28px;
    height: 28px;
    background: var(--accent-light);
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 14px;
  }

  .pitch-line {
    font-size: 0.9rem;
    color: var(--text-2);
    line-height: 1.65;
    margin-bottom: 0.6rem;
    padding-left: 1rem;
    border-left: 2px solid var(--border);
  }

  .pitch-line strong { color: var(--text); font-weight: 600; }
  .pitch-line:last-child { margin-bottom: 0; }

  .pitch-note {
    font-size: 0.78rem;
    color: var(--text-3);
    margin-top: 0.85rem;
    padding-top: 0.85rem;
    border-top: 1px solid var(--border);
    font-style: italic;
  }

  .footer {
    text-align: center;
    font-size: 0.75rem;
    color: var(--text-3);
    padding-top: 1rem;
    border-top: 1px solid var(--border);
  }

  hr.divider {
    border: none;
    border-top: 1px solid var(--border);
    margin: 1.5rem 0;
  }

  .annual-bar {
    background: var(--surface2);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1rem 1.25rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 1.25rem;
  }

  .annual-bar .a-item { text-align: center; }
  .annual-bar .a-label { font-size: 0.72rem; color: var(--text-3); text-transform: uppercase; letter-spacing: 0.05em; font-weight: 500; }
  .annual-bar .a-val { font-size: 1.1rem; font-weight: 600; font-family: 'DM Mono', monospace; color: var(--text); letter-spacing: -0.01em; margin-top: 2px; }
  .annual-bar .a-val.green { color: var(--green); }
  .annual-bar .a-val.blue { color: var(--accent-dark); }
</style>
</head>
<body>
<div class="page">

  <div class="header">
    <div class="header-top">
      <div>
        <h1>Google Ads ROI Calculator</h1>
        <p>Security camera installation — Sydney market projections</p>
      </div>
      <div style="display:flex;gap:8px;flex-wrap:wrap;padding-top:4px;">
        <span class="badge badge-blue"><span class="dot"></span>Live projections</span>
        <span class="badge badge-green"><span class="dot"></span>37.5% GP industry standard</span>
      </div>
    </div>
  </div>

  <div class="grid-2">
    <div class="card">
      <p class="card-label">Campaign settings</p>

      <div class="slider-group">
        <div class="slider-header">
          <label>Monthly ad budget</label>
          <span class="val" id="budget-out">$1,500</span>
        </div>
        <input type="range" id="budget" min="1000" max="5000" step="100" value="1500">
      </div>

      <div class="slider-group">
        <div class="slider-header">
          <label>Target CPA (cost per lead)</label>
          <span class="val" id="cpa-out">$100</span>
        </div>
        <input type="range" id="cpa" min="60" max="200" step="5" value="100">
      </div>

      <div class="slider-group">
        <div class="slider-header">
          <label>Lead-to-job close rate</label>
          <span class="val" id="close-out">28%</span>
        </div>
        <input type="range" id="close" min="10" max="60" step="1" value="28">
      </div>
    </div>

    <div class="card">
      <p class="card-label">Business settings</p>

      <div class="slider-group">
        <div class="slider-header">
          <label>Average job value</label>
          <span class="val" id="jobval-out">$2,000</span>
        </div>
        <input type="range" id="jobval" min="1400" max="4000" step="100" value="2000">
      </div>

      <div class="slider-group">
        <div class="slider-header">
          <label>Gross profit margin</label>
          <span class="val" id="gp-out">37.5%</span>
        </div>
        <input type="range" id="gp" min="20" max="55" step="0.5" value="37.5">
      </div>

      <div class="slider-group">
        <div class="slider-header">
          <label>Ad spend growth (monthly)</label>
          <span class="val" id="growth-out">5%</span>
        </div>
        <input type="range" id="growth" min="0" max="20" step="1" value="5">
      </div>
    </div>
  </div>

  <p class="section-title">Monthly snapshot</p>
  <div class="metrics-grid" id="metrics"></div>

  <div class="annual-bar" id="annual-bar"></div>

  <p class="section-title">Scenario comparison — at current budget</p>
  <div class="scenario-grid" id="scenarios"></div>

  <div class="chart-section">
    <p class="section-title" style="margin-bottom:0.5rem">12-month revenue &amp; profit projection</p>
    <div class="chart-legend">
      <span class="legend-item"><span class="legend-dot" style="background:#93b4f0"></span>Revenue</span>
      <span class="legend-item"><span class="legend-dot" style="background:#6ee7b7"></span>Gross profit</span>
    </div>
    <div class="chart-wrap">
      <canvas id="chart" role="img" aria-label="Bar chart showing projected monthly revenue and gross profit over 12 months">Monthly revenue and gross profit projections across 12 months.</canvas>
    </div>
  </div>

  <div class="pitch-card" id="pitch-card">
    <h3>
      <span class="pitch-icon">&#128200;</span>
      Pitch summary
    </h3>
    <div id="pitch-lines"></div>
  </div>

  <div class="footer">
    Projections based on target CPA, close rate, and job value inputs. Actual results will vary. Industry GP benchmark: 37.5% (Security Sales &amp; Integration, 2020).
  </div>

</div>

<script>
let chartInst = null;

const fmt = n => '$' + Math.round(n).toLocaleString();
const pct = n => parseFloat(n).toFixed(1) + '%';

function calc(budget, cpa, closeRate, jobVal, gpPct) {
  const leads = budget / cpa;
  const jobs = leads * (closeRate / 100);
  const revenue = jobs * jobVal;
  const profit = revenue * (gpPct / 100);
  const roas = revenue / budget;
  const roi = ((profit - budget) / budget) * 100;
  return { leads, jobs, revenue, profit, roas, roi };
}

function render() {
  const budget  = +document.getElementById('budget').value;
  const cpa     = +document.getElementById('cpa').value;
  const close   = +document.getElementById('close').value;
  const jobval  = +document.getElementById('jobval').value;
  const gp      = +document.getElementById('gp').value;
  const growth  = +document.getElementById('growth').value;

  document.getElementById('budget-out').textContent = fmt(budget);
  document.getElementById('cpa-out').textContent    = fmt(cpa);
  document.getElementById('close-out').textContent  = Math.round(close) + '%';
  document.getElementById('jobval-out').textContent = fmt(jobval);
  document.getElementById('gp-out').textContent     = pct(gp);
  document.getElementById('growth-out').textContent = Math.round(growth) + '%';

  const r = calc(budget, cpa, close, jobval, gp);

  document.getElementById('metrics').innerHTML = `
    <div class="metric-card accent">
      <p class="m-label">Leads / month</p>
      <p class="m-value">${Math.round(r.leads)}</p>
      <p class="m-sub">at ${fmt(cpa)} CPA</p>
    </div>
    <div class="metric-card">
      <p class="m-label">Jobs won</p>
      <p class="m-value">${Math.round(r.jobs)}</p>
      <p class="m-sub">${Math.round(close)}% close rate</p>
    </div>
    <div class="metric-card">
      <p class="m-label">Monthly revenue</p>
      <p class="m-value">${fmt(r.revenue)}</p>
      <p class="m-sub">${fmt(jobval)} avg job</p>
    </div>
    <div class="metric-card green">
      <p class="m-label">Gross profit</p>
      <p class="m-value">${fmt(r.profit)}</p>
      <p class="m-sub">${pct(gp)} GP margin</p>
    </div>
    <div class="metric-card">
      <p class="m-label">ROAS</p>
      <p class="m-value">${r.roas.toFixed(1)}x</p>
      <p class="m-sub">revenue per $1 spent</p>
    </div>
    <div class="metric-card">
      <p class="m-label">Profit ROI</p>
      <p class="m-value">${Math.round(r.roi)}%</p>
      <p class="m-sub">GP minus ad spend</p>
    </div>
  `;

  const months = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
  const revData = [];
  const profData = [];
  let runBudget = budget;
  for (let i = 0; i < 12; i++) {
    const ramp = Math.min(1, 0.55 + i * 0.045);
    const mr = calc(runBudget, cpa, close, jobval, gp);
    revData.push(Math.round(mr.revenue * ramp));
    profData.push(Math.round(mr.profit * ramp));
    runBudget = runBudget * (1 + growth / 100);
  }

  const annualRev    = revData.reduce((a,b) => a+b, 0);
  const annualProfit = profData.reduce((a,b) => a+b, 0);
  const annualSpend  = (() => {
    let s = budget, total = 0;
    for (let i = 0; i < 12; i++) { total += s; s *= (1 + growth / 100); }
    return total;
  })();

  document.getElementById('annual-bar').innerHTML = `
    <div class="a-item"><p class="a-label">Annual ad spend</p><p class="a-val">${fmt(annualSpend)}</p></div>
    <div class="a-item"><p class="a-label">Annual revenue</p><p class="a-val blue">${fmt(annualRev)}</p></div>
    <div class="a-item"><p class="a-label">Annual gross profit</p><p class="a-val green">${fmt(annualProfit)}</p></div>
    <div class="a-item"><p class="a-label">Annual ROAS</p><p class="a-val">${(annualRev / annualSpend).toFixed(1)}x</p></div>
    <div class="a-item"><p class="a-label">Jobs won (year)</p><p class="a-val">${Math.round(revData.reduce((a,b)=>a+b,0) / jobval)}</p></div>
  `;

  const cons = calc(budget, 150, close, 1800, gp);
  const real = calc(budget, 100, close, jobval, gp);
  const opt  = calc(budget, 75,  close, 2500, gp);

  document.getElementById('scenarios').innerHTML = `
    <div class="scenario">
      <p class="s-tag">Conservative</p>
      <p class="s-profit">${fmt(cons.profit)}<span style="font-size:0.7rem;font-weight:400;color:var(--text-3);font-family:'DM Sans',sans-serif"> /mo profit</span></p>
      <div class="s-row"><span>CPA</span><span>$150</span></div>
      <div class="s-row"><span>Leads</span><span>${Math.round(cons.leads)}</span></div>
      <div class="s-row"><span>Jobs</span><span>${Math.round(cons.jobs)}</span></div>
      <div class="s-row"><span>Revenue</span><span>${fmt(cons.revenue)}</span></div>
      <div class="s-row"><span>ROAS</span><span>${cons.roas.toFixed(1)}x</span></div>
    </div>
    <div class="scenario featured">
      <p class="s-tag">Realistic target</p>
      <p class="s-profit">${fmt(real.profit)}<span style="font-size:0.7rem;font-weight:400;color:var(--text-3);font-family:'DM Sans',sans-serif"> /mo profit</span></p>
      <div class="s-row"><span>CPA</span><span>$100</span></div>
      <div class="s-row"><span>Leads</span><span>${Math.round(real.leads)}</span></div>
      <div class="s-row"><span>Jobs</span><span>${Math.round(real.jobs)}</span></div>
      <div class="s-row"><span>Revenue</span><span>${fmt(real.revenue)}</span></div>
      <div class="s-row"><span>ROAS</span><span>${real.roas.toFixed(1)}x</span></div>
    </div>
    <div class="scenario">
      <p class="s-tag">Optimistic</p>
      <p class="s-profit">${fmt(opt.profit)}<span style="font-size:0.7rem;font-weight:400;color:var(--text-3);font-family:'DM Sans',sans-serif"> /mo profit</span></p>
      <div class="s-row"><span>CPA</span><span>$75</span></div>
      <div class="s-row"><span>Leads</span><span>${Math.round(opt.leads)}</span></div>
      <div class="s-row"><span>Jobs</span><span>${Math.round(opt.jobs)}</span></div>
      <div class="s-row"><span>Revenue</span><span>${fmt(opt.revenue)}</span></div>
      <div class="s-row"><span>ROAS</span><span>${opt.roas.toFixed(1)}x</span></div>
    </div>
  `;

  if (chartInst) chartInst.destroy();
  chartInst = new Chart(document.getElementById('chart'), {
    type: 'bar',
    data: {
      labels: months,
      datasets: [
        {
          label: 'Revenue',
          data: revData,
          backgroundColor: '#93b4f0',
          borderRadius: 4,
          borderSkipped: false
        },
        {
          label: 'Gross profit',
          data: profData,
          backgroundColor: '#6ee7b7',
          borderRadius: 4,
          borderSkipped: false
        }
      ]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      plugins: {
        legend: { display: false },
        tooltip: {
          callbacks: { label: ctx => ' ' + fmt(ctx.parsed.y) }
        }
      },
      scales: {
        x: {
          ticks: { color: '#9e9b93', font: { family: 'DM Sans', size: 11 } },
          grid: { display: false },
          border: { display: false }
        },
        y: {
          ticks: {
            callback: v => '$' + Math.round(v / 1000) + 'k',
            color: '#9e9b93',
            font: { family: 'DM Sans', size: 11 }
          },
          grid: { color: '#f0efe9' },
          border: { display: false }
        }
      }
    }
  });

  const pitchLeads = Math.round(real.leads);
  const pitchJobs  = Math.round(real.jobs);

  document.getElementById('pitch-lines').innerHTML = `
    <p class="pitch-line">At <strong>${fmt(budget)}/month</strong>, a Search-only campaign rebuilt from scratch should deliver around <strong>${pitchLeads} qualified leads per month</strong> — people in Sydney actively searching for security camera installation.</p>
    <p class="pitch-line">With a <strong>${Math.round(close)}% close rate</strong>, that's <strong>${pitchJobs} jobs per month</strong> — generating <strong>${fmt(real.revenue)} in revenue</strong> and <strong>${fmt(real.profit)} in gross profit</strong> at the ${pct(gp)} industry-standard GP margin.</p>
    <p class="pitch-line">That's a <strong>${real.roas.toFixed(1)}x return on ad spend</strong>. Every dollar invested in ads returns ${real.roas.toFixed(1)} dollars in revenue.</p>
    <p class="pitch-line">Over 12 months, with a ${Math.round(growth)}% monthly budget growth as results compound: <strong>${fmt(annualRev)} in revenue</strong> and <strong>${fmt(annualProfit)} in gross profit</strong> from a ${fmt(annualSpend)} annual ad investment.</p>
    <p class="pitch-note">Based on a $100 CPA target — realistic for a Search-only local campaign with a strong landing page. The existing campaign ran at $168 CPA with Display Network enabled, burning budget on low-intent clicks. A clean rebuild eliminates this waste.</p>
  `;
}

['budget','cpa','close','jobval','gp','growth'].forEach(id => {
  document.getElementById(id).addEventListener('input', render);
});

render();
</script>
</body>
</html>
